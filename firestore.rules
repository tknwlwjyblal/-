rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == 'tknwlwjyblal@gmail.com' ||
         request.auth.token.email == 'dev520top@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSignedIn());
      allow list: if isSignedIn();
      allow create, update: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // Device tokens are private to the authenticated account, never public profile data.
    match /users/{userId}/devices/{deviceId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt == request.time;
    }

    // Savings Circles collection
    match /circles/{circleId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(circleId);
      allow delete: if isSignedIn() && isValidId(circleId) &&
        (isSuperAdmin() || !('isConfirmedByAdmin' in resource.data) || resource.data.isConfirmedByAdmin != true);
    }

    // Payments collection
    match /payments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(paymentId);
      allow delete: if isSignedIn() && isValidId(paymentId) && isSuperAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(notificationId);
      allow delete: if isSignedIn() && isValidId(notificationId);
    }

    // System Logs & Error Tracking collection
    match /system_logs/{logId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if isSignedIn() && isValidId(logId) && isSuperAdmin();
    }

    // Global App Settings collection
    match /app_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(settingId) && isSuperAdmin();
    }
  }
}
